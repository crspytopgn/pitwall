{
  "name": "pitwall",
  "version": "0.1.0",
  "description": "Sim racing companion for SteamOS / Steam Machine: telemetry, coaching, phone dashboard, wheel control, game guide",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests"
  },
  "keywords": [
    "decky",
    "plugin",
    "sim-racing",
    "moza",
    "telemetry",
    "steamos"
  ],
  "author": "Michael Carruthers",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}